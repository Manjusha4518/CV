    private static String getClassFieldValue(String json, String classNumber, String fieldName) {

        try {

            List<Map<String, Object>> classes = JsonPath.read(json, "$..classes[*]");

            for (Map<String, Object> cls : classes) {

                Object clsNum = cls.get("classNumber");

                if (clsNum == null) continue;

                if (normalize(String.valueOf(clsNum)).equalsIgnoreCase(normalize(classNumber))) {

                    Object value = cls.get(fieldName);

                    return value == null ? "" : normalize(String.valueOf(value));
                }
            }

        } catch (Exception e) {

            e.printStackTrace();
        }

        return "";
    }

    private static String getMatchingValue(String json, String jsonPath, String expected) {

        try {

            List<Object> values = JsonPath.read(json, jsonPath);

            for (Object obj : values) {

                if (obj == null) continue;

                String value = normalize(String.valueOf(obj));

                if (value.equalsIgnoreCase(normalize(expected))) {

                    return value;
                }
            }

        } catch (Exception e) {

            e.printStackTrace();
        }

        return "";
    }

    private static String readJsonValue(String json, String jsonPath) {

        try {

            Object result = JsonPath.read(json, jsonPath);

            if (result == null) return "";

            if (result instanceof List) {
                List<?> list = (List<?>) result;
                if (list.isEmpty() || list.get(0) == null) return "";
                return normalize(String.valueOf(list.get(0)));
            }
            return normalize(String.valueOf(result));

        } catch (Exception e) {

            return "";
        }
    }

    private static void checkMissingAndNewFields(List<ExcelField> previousFields, List<ExcelField> currentFields, String version, String workbookName, String jsonName, String policyNumber) {

        for (ExcelField previous : previousFields) {

            boolean found = false;

            for (ExcelField current : currentFields) {

                if (normalizeKey(previous.getFieldName()).equalsIgnoreCase(normalizeKey(current.getFieldName()))) {

                    found = true;

                    break;
                }
            }

            if (!found) {

                ValidationResult vr = new ValidationResult();

                vr.setPolicyNumber(policyNumber);

                vr.setVersion(version);

                vr.setFieldName(previous.getFieldName());

                vr.setExpectedValue(previous.getValue());

                vr.setActualValue("FIELD MISSING");

                vr.setStatus("MISSING_IN_CURRENT_VERSION");

                vr.setWorkbookFile(workbookName);

                vr.setJsonFile(jsonName);

                ResultStore.results.add(vr);
            }
        }
    }

    private static String getFieldValue(List<ExcelField> fields, String... aliases) {

        for (ExcelField ef : fields) {

            String fieldName = normalizeKey(ef.getFieldName());

            for (String alias : aliases) {

                if (fieldName.contains(normalizeKey(alias))) {

                    return normalize(ef.getValue());
                }
            }
        }

        return "";
    }

    private static String formatDate(String input) {

        try {

            if (input.contains("T")) {

                input = input.substring(0, 10);
            }

            SimpleDateFormat in = new SimpleDateFormat("yyyy-MM-dd");

            SimpleDateFormat out = new SimpleDateFormat("MM/dd/yyyy");

            Date d = in.parse(input);

            return out.format(d);

        } catch (Exception e) {

            return input;
        }
    }

    private static String normalize(String value) {

        if (value == null) return "";

        value = value.trim();

        if (value.endsWith(".0")) {

            value = value.substring(0, value.length() - 2);
        }

        try {

            if (value.contains("E") || value.contains("e")) {

                BigDecimal bd = new BigDecimal(value);

                value = bd.toPlainString();
            }

        } catch (Exception e) {
        }

        return value.replace("\n", "").replace("\r", "").replace("T00:00:00Z", "").trim();
    }

    private static String normalizeKey(String key) {

        if (key == null) return "";

        return key.replaceAll("[^a-zA-Z0-9]", "").trim().toLowerCase();
    }

    private static String getHighestVersion(Set<String> versions) {

        int highest = Integer.MIN_VALUE;

        for (String version : versions) {

            try {

                int value = Integer.parseInt(version.replaceAll("[^0-9]", ""));

                if (value > highest) {

                    highest = value;
                }

            } catch (Exception e) {
            }
        }

        if (highest == Integer.MIN_VALUE) {

            return "";
        }

        return String.valueOf(highest);
    }

    public static String extractDate(String input) {
        if (input == null || input.isEmpty()) return "";
        return input.substring(0, 10);
    }

    public static String convertDate(String input) {
        if (input == null || input.length() < 10) return "";
        String[] parts = input.substring(0, 10).split("-");
        return parts[1] + "/" + parts[2];
    }

    public static String toTitleCase(String input) {
        if (input == null || input.isEmpty()) return "";
        return input.substring(0, 1).toUpperCase() + input.substring(1).toLowerCase();
    }


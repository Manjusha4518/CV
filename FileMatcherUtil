package utilities;

import java.io.File;
import java.util.HashMap;
import java.util.Map;

public class FileMatcherUtil {

    public static Map<File, File>
    getMatchedFiles() {

        Map<File, File> matched =
                new HashMap<>();

        File workbookFolder =
                new File(
                        "src/test/resources/testdata/workbooks");

        File jsonFolder =
                new File(
                        "src/test/resources/testdata/json");

        File[] workbooks =
                workbookFolder.listFiles();

        File[] jsons =
                jsonFolder.listFiles();

        for (File workbook : workbooks) {

            String policyNumber =
                    workbook.getName()
                            .split("_")[1];

            for (File json : jsons) {

                if (json.getName()
                        .contains(policyNumber)) {

                    matched.put(workbook,
                            json);

                    break;
                }
            }
        }

        return matched;
    }
}

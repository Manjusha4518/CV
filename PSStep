@When("User validates Payment Specification data with Claims UI")
public void validatePaymentSpecificationDataWithClaimsUI() throws Exception {

    String sourceFile = System.getProperty("user.dir")
            + "/testData/PaymentSpecification_out.csv";

    String loadedFile = System.getProperty("user.dir")
            + "/testData/loaded payment specs disability 08-20-2026.csv";

    List<Map<String, String>> sourceData = csvUtil.getCSVData(sourceFile);
    List<Map<String, String>> loadedData = csvUtil.getCSVData(loadedFile);

    // Create lookup:
    // Unique Key -> PS Name
    Map<String, String> psNameLookup = new HashMap<>();

    for (Map<String, String> loadedRow : loadedData) {

        String uniqueKey = getCsvValue(loadedRow, "Unique Key");
        String psName = getCsvValue(loadedRow, "Name");

        if (!uniqueKey.isEmpty() && !psName.isEmpty()) {
            psNameLookup.put(
                    normalize(uniqueKey),
                    normalize(psName)
            );
        }
    }

    // Group source records by Claim Number
    Map<String, List<Map<String, String>>> claimWiseData =
            new LinkedHashMap<>();

    for (Map<String, String> sourceRow : sourceData) {

        String claimNumber =
                normalize(getCsvValue(sourceRow, "Claim Number"));

        if (!claimNumber.isEmpty()) {
            claimWiseData
                    .computeIfAbsent(claimNumber, k -> new ArrayList<>())
                    .add(sourceRow);
        }
    }

    // Process each claim only once
    for (Map.Entry<String, List<Map<String, String>>> claimEntry
            : claimWiseData.entrySet()) {

        String claimNumber = claimEntry.getKey();
        List<Map<String, String>> claimRows = claimEntry.getValue();

        ExtentTest claimTest = extent.createTest(
                "Payment Specification Validation - Claim: "
                        + claimNumber);

        claimTest.info("Claim Number: " + claimNumber);
        claimTest.info("Source Payment Specification records: "
                + claimRows.size());

        // Search/open claim only once
        searchAndOpenClaim(claimNumber);

        // Process every Payment Specification belonging to this claim
        for (Map<String, String> sourceRow : claimRows) {

            String claimBusinessObjNumber =
                    normalize(getCsvValue(
                            sourceRow,
                            "Claim Business Obj Number"));

            String objectNumber =
                    normalize(getCsvValue(
                            sourceRow,
                            "Object Number"));

            // Build Unique Key
            String uniqueKey =
                    claimBusinessObjNumber + "-" + objectNumber;

            claimTest.info(
                    "Claim Business Obj Number: "
                            + claimBusinessObjNumber);

            claimTest.info(
                    "Object Number: "
                            + objectNumber);

            claimTest.info(
                    "Generated Unique Key: "
                            + uniqueKey);

            // Get PS Name from loaded CSV
            String psName = psNameLookup.get(
                    normalize(uniqueKey));

            if (psName == null || psName.isEmpty()) {

                claimTest.fail(
                        "No Payment Specification found in loaded file "
                                + "for Unique Key: " + uniqueKey);

                continue;
            }

            claimTest.pass(
                    "Payment Specification found: "
                            + psName
                            + " for Unique Key: "
                            + uniqueKey);

            // ----------------------------------------------------
            // Now use PS NAME to locate the Payment Specification
            // in Claims UI
            // ----------------------------------------------------

            boolean psFound =
                    findPaymentSpecificationInUI(psName);

            if (!psFound) {

                claimTest.fail(
                        "Payment Specification "
                                + psName
                                + " not found in Claims UI");

                continue;
            }

            claimTest.pass(
                    "Payment Specification "
                            + psName
                            + " found in Claims UI");

            // ----------------------------------------------------
            // Validate the required SOURCE fields against UI
            // ----------------------------------------------------

            validateSourceFieldsAgainstUI(
                    sourceRow,
                    psName,
                    claimTest);
        }
    }
}

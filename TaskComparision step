    // ============================================================
    // GET TEXT FROM TASK CARD
    // ============================================================

    private String getText(
            WebElement parent,
            By locator) {


        try {

            WebElement element =
                    parent.findElement(
                            locator
                    );


            return normalize(
                    element.getText()
            );

        } catch (Exception e) {

            return "";
        }
    }


    // ============================================================
    // DECODE COMMENTS
    // ============================================================

    private Map<String, String>
    decodeComments(String comment) {


        Map<String, String> data =
                new LinkedHashMap<>();


        if (comment == null) {

            return data;
        }


        String text =
                comment
                        .replace("&nbsp;", " ")
                        .replace("<p>", " ")
                        .replace("</p>", " ")
                        .replace("<br>", " ")
                        .replace("<br/>", " ")
                        .replace("<br />", " ")
                        .replaceAll(
                                "<[^>]*>",
                                " "
                        );


        text =
                normalize(text);


        /*
         * ========================================================
         * WORKCELL
         *
         * Example:
         *
         * Assign To: WORKCELL-CE-LTD -> 426rtj
         * ========================================================
         */

        String workcell =
                extract(
                        text,
                        "Assign\\s*To\\s*:\\s*([^\\-]+(?:-[^\\s]+)*)\\s*->"
                );


        if (workcell.isEmpty()) {

            workcell =
                    extract(
                            text,
                            "Assign\\s*To\\s*:\\s*(.*?)\\s*->"
                    );
        }


        data.put(
                "Workcell",
                normalize(workcell)
        );


        /*
         * ========================================================
         * TASK TYPE
         *
         * Example:
         *
         * Task Type: Regular Task
         * ========================================================
         */

        String taskType =
                extract(
                        text,
                        "Task\\s*Type\\s*:\\s*(.*?)(?=Details\\s*:|Completed\\s*Date\\s*:|$)"
                );


        data.put(
                "Task Type",
                normalize(taskType)
        );


        /*
         * ========================================================
         * DETAILS
         * ========================================================
         */

        String details =
                extract(
                        text,
                        "Details\\s*:\\s*(.*?)(?=Completed\\s*Date\\s*:|$)"
                );


        data.put(
                "Details",
                normalize(details)
        );


        /*
         * ========================================================
         * COMPLETED DATE
         *
         * Example:
         *
         * Completed Date: 05/26/26
         * ========================================================
         */

        String completedDate =
                extract(
                        text,
                        "Completed\\s*Date\\s*:\\s*(.*?)(?=$)"
                );


        data.put(
                "Completed Date",
                normalize(completedDate)
        );


        return data;
    }


    // ============================================================
    // REGEX EXTRACTION
    // ============================================================

    private String extract(
            String text,
            String regex) {


        try {

            Pattern pattern =
                    Pattern.compile(
                            regex,
                            Pattern.CASE_INSENSITIVE
                    );


            Matcher matcher =
                    pattern.matcher(text);


            if (matcher.find()) {

                return matcher.group(1);
            }


        } catch (Exception e) {

            System.out.println(
                    "Regex error : "
                            + regex
            );
        }


        return "";
    }


    // ============================================================
    // FIELD VALIDATION
    // ============================================================

    private void validateField(
            ExtentTest taskNode,
            Map<String, String> csvData,
            Map<String, String> uiData,
            String fieldName) {


        String expected =
                getCsvValue(
                        csvData,
                        fieldName
                );


        String actual =
                uiData.get(fieldName);


        if (actual == null) {

            actual = "";
        }


        expected =
                normalize(expected);


        actual =
                normalize(actual);


        /*
         * Date normalization can be added here
         * if CSV and UI use different formats.
         */

        boolean matched =
                expected.equalsIgnoreCase(
                        actual
                );


        if (matched) {

            taskNode.pass(
                    "<b>"
                            + fieldName
                            + "</b>"
                            + "<br>Expected : "
                            + expected
                            + "<br>Actual : "
                            + actual
                            + "<br>Status : PASS"
            );

        } else {

            taskNode.fail(
                    "<b>"
                            + fieldName
                            + "</b>"
                            + "<br>Expected : "
                            + expected
                            + "<br>Actual : "
                            + actual
                            + "<br>Status : FAIL"
            );
        }
    }


    // ============================================================
    // GET CSV VALUE
    // ============================================================

    private String getCsvValue(
            Map<String, String> row,
            String fieldName) {


        if (row == null) {

            return "";
        }


        /*
         * Direct match
         */

        if (row.containsKey(fieldName)) {

            return row.get(fieldName);
        }


        /*
         * Case-insensitive match
         */

        for (Map.Entry<String, String> entry :
                row.entrySet()) {


            if (entry.getKey()
                    .equalsIgnoreCase(fieldName)) {

                return entry.getValue();
            }
        }


        /*
         * ========================================================
         * CSV FIELD MAPPING
         * ========================================================
         *
         * Add your actual CSV column mappings here.
         */

        if (fieldName.equalsIgnoreCase(
                "Workcell")) {

            return findCsvValue(
                    row,
                    "Description"
            );
        }


        if (fieldName.equalsIgnoreCase(
                "Task Type")) {

            return findCsvValue(
                    row,
                    "Task Type"
            );
        }


        if (fieldName.equalsIgnoreCase(
                "Due Date")) {

            return findCsvValue(
                    row,
                    "Due Date"
            );
        }


        if (fieldName.equalsIgnoreCase(
                "Assigned To")) {

            return findCsvValue(
                    row,
                    "Assigned To"
            );
        }


        if (fieldName.equalsIgnoreCase(
                "Details")) {

            return findCsvValue(
                    row,
                    "Forwarded Details"
            );
        }


        return "";
    }


    // ============================================================
    // FIND CSV COLUMN
    // ============================================================

    private String findCsvValue(
            Map<String, String> row,
            String columnName) {


        for (Map.Entry<String, String> entry :
                row.entrySet()) {


            if (entry.getKey()
                    .equalsIgnoreCase(
                            columnName
                    )) {

                return entry.getValue();
            }
        }


        return "";
    }


    // ============================================================
    // NORMALIZE
    // ============================================================

    private String normalize(
            String value) {


        if (value == null) {

            return "";
        }


        return value
                .replace("\u00A0", " ")
                .replace("&nbsp;", " ")
                .replaceAll(
                        "\\s+",
                        " "
                )
                .trim();
    }


    // ============================================================
    // WAIT
    // ============================================================

    private void waitForPage() {

        try {

            Thread.sleep(2000);

        } catch (InterruptedException e) {

            Thread.currentThread()
                    .interrupt();
        }
    }


    // ============================================================
    // RETURN TO ORIGINAL WINDOW
    // ============================================================

    private void switchToOriginalWindow() {

        try {

            Set<String> handles =
                    driver.getWindowHandles();


            if (!handles.isEmpty()) {

                driver.switchTo()
                        .window(
                                handles.iterator()
                                        .next()
                        );
            }

        } catch (Exception e) {

            System.out.println(
                    "Unable to switch to original window: "
                            + e.getMessage()
            );
        }
    }

    // CLICK VIEW ALL
    // ============================================================

    private void clickViewAll() {

        driver.findElement(
                viewAllButton
        ).click();


        waitForPage();
    }


    // ============================================================
    // SWITCH TO NEW WINDOW
    // ============================================================

    private void switchToTaskWindow() {

        String originalWindow =
                driver.getWindowHandle();


        Set<String> oldWindows =
                driver.getWindowHandles();


        /*
         * Wait for new window.
         */

        long start =
                System.currentTimeMillis();


        while (System.currentTimeMillis()
                - start < 15000) {


            Set<String> currentWindows =
                    driver.getWindowHandles();


            if (currentWindows.size()
                    > oldWindows.size()) {


                for (String window :
                        currentWindows) {

                    if (!oldWindows.contains(window)) {

                        driver.switchTo()
                                .window(window);

                        return;
                    }
                }
            }


            try {

                Thread.sleep(500);

            } catch (InterruptedException e) {

                Thread.currentThread()
                        .interrupt();
            }
        }


        /*
         * Sometimes View All does NOT open a new
         * browser window.
         *
         * In that case remain on current window.
         */

        driver.switchTo()
                .window(originalWindow);
    }


    // ============================================================
    // VALIDATE ALL TASKS
    // ============================================================

    private void validateTasks(
            ExtentTest claimTest,
            List<Map<String, String>> csvTasks,
            List<WebElement> uiTasks) {


        int commonCount =
                Math.min(
                        csvTasks.size(),
                        uiTasks.size()
                );


        /*
         * ========================================================
         * COMPARE EACH TASK
         * ========================================================
         */

        for (int i = 0;
             i < commonCount;
             i++) {


            Map<String, String> csvTask =
                    csvTasks.get(i);


            WebElement uiTask =
                    uiTasks.get(i);


            ExtentTest taskNode =
                    claimTest.createNode(
                            "Task "
                                    + (i + 1)
                    );


            taskNode.info(
                    "CSV Task Record : "
                            + (i + 1)
            );


            /*
             * Read UI values
             */

            Map<String, String> uiData =
                    readUiTask(uiTask);


            /*
             * Decode Comments
             */

            Map<String, String>
                    commentData =
                    decodeComments(
                            uiData.get("Comments")
                    );


            /*
             * Add decoded values to UI map
             */

            uiData.putAll(
                    commentData
            );


            /*
             * ====================================================
             * FIELD VALIDATION
             * ====================================================
             */

            validateField(
                    taskNode,
                    csvTask,
                    uiData,
                    "Subject"
            );


            validateField(
                    taskNode,
                    csvTask,
                    uiData,
                    "Primary Name"
            );


            validateField(
                    taskNode,
                    csvTask,
                    uiData,
                    "Due Date"
            );


            validateField(
                    taskNode,
                    csvTask,
                    uiData,
                    "Assigned To"
            );


            validateField(
                    taskNode,
                    csvTask,
                    uiData,
                    "Last Modified Date"
            );


            /*
             * Comment-derived fields
             */

            validateField(
                    taskNode,
                    csvTask,
                    uiData,
                    "Workcell"
            );


            validateField(
                    taskNode,
                    csvTask,
                    uiData,
                    "Task Type"
            );


            validateField(
                    taskNode,
                    csvTask,
                    uiData,
                    "Details"
            );


            validateField(
                    taskNode,
                    csvTask,
                    uiData,
                    "Completed Date"
            );
        }


        /*
         * ========================================================
         * MISSING UI TASKS
         * ========================================================
         */

        if (csvTasks.size()
                > uiTasks.size()) {


            for (int i =
                         uiTasks.size();
                 i < csvTasks.size();
                 i++) {


                ExtentTest missingTask =
                        claimTest.createNode(
                                "Missing UI Task "
                                        + (i + 1)
                        );


                missingTask.fail(
                        "Task exists in CSV but NOT in UI."
                                + "<br>CSV Record : "
                                + (i + 1)
                );


                /*
                 * Print all CSV fields
                 */

                for (Map.Entry<String, String> entry :
                        csvTasks.get(i).entrySet()) {

                    missingTask.info(
                            entry.getKey()
                                    + " = "
                                    + entry.getValue()
                    );
                }
            }
        }


        /*
         * ========================================================
         * EXTRA UI TASKS
         * ========================================================
         */

        if (uiTasks.size()
                > csvTasks.size()) {


            for (int i =
                         csvTasks.size();
                 i < uiTasks.size();
                 i++) {


                ExtentTest extraTask =
                        claimTest.createNode(
                                "Extra UI Task "
                                        + (i + 1)
                        );


                extraTask.fail(
                        "Task exists in UI but NOT in CSV."
                );


                Map<String, String> uiData =
                        readUiTask(
                                uiTasks.get(i)
                        );


                for (Map.Entry<String, String> entry :
                        uiData.entrySet()) {

                    extraTask.info(
                            entry.getKey()
                                    + " = "
                                    + entry.getValue()
                    );
                }
            }
        }
    }



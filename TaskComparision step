    @When("User compares Disability Claim task data with UI")
    public void compareDisabilityClaimTaskDataWithUI() {

        /*
         * ========================================================
         * 1. READ CSV
         * ========================================================
         */

        List<Map<String, String>> csvRows =
                CsvUtil.getCsvData(csvFilePath);


        if (csvRows == null || csvRows.isEmpty()) {

            throw new RuntimeException(
                    "No records found in CSV: "
                            + csvFilePath
            );
        }


        System.out.println(
                "Total CSV Records = "
                        + csvRows.size()
        );


        /*
         * ========================================================
         * 2. GROUP CSV RECORDS BY CLAIM NUMBER
         * ========================================================
         *
         * IMPORTANT:
         *
         * Claim Number may appear multiple times because
         * every task is a separate CSV record.
         *
         * Example:
         *
         * Claim 123
         * Task 1
         * Task 2
         * Task 3
         *
         * Claim is searched ONLY ONCE.
         */

        Map<String, List<Map<String, String>>>
                claimTaskMap =
                new LinkedHashMap<>();


        for (Map<String, String> row : csvRows) {

            String claimNumber =
                    getCsvValue(
                            row,
                            "Claim Number"
                    );


            if (claimNumber == null
                    || claimNumber.trim().isEmpty()) {

                continue;
            }


            claimNumber =
                    normalize(claimNumber);


            claimTaskMap
                    .computeIfAbsent(
                            claimNumber,
                            k -> new ArrayList<>()
                    )
                    .add(row);
        }


        System.out.println(
                "Total Claims = "
                        + claimTaskMap.size()
        );


        /*
         * ========================================================
         * 3. CREATE EXTENT REPORT
         * ========================================================
         *
         * USE YOUR EXISTING ExtentManager.
         */

        String reportFolder =
                System.getProperty("user.dir")
                        + "/testResult/TaskComparison";


        extent =
                ExtentManager.getInstance(
                        reportFolder
                );


        /*
         * ========================================================
         * 4. PROCESS EACH CLAIM
         * ========================================================
         */

        for (Map.Entry<String,
                List<Map<String, String>>> claimEntry
                : claimTaskMap.entrySet()) {


            String claimNumber =
                    claimEntry.getKey();


            List<Map<String, String>>
                    expectedTasks =
                    claimEntry.getValue();


            /*
             * One Extent test for one claim
             */

            ExtentTest claimTest =
                    extent.createTest(
                            "Claim Number : "
                                    + claimNumber
                    );


            try {

                claimTest.info(
                        "CSV Task Count : "
                                + expectedTasks.size()
                );


                /*
                 * =================================================
                 * 5. SEARCH CLAIM
                 * =================================================
                 *
                 * CLAIM NUMBER ENTERED ONLY ONCE.
                 */

                searchClaim(claimNumber);


                claimTest.pass(
                        "Claim searched successfully : "
                                + claimNumber
                );


                /*
                 * =================================================
                 * 6. CLICK VIEW ALL
                 * =================================================
                 */

                clickViewAll();


                claimTest.info(
                        "Clicked View All to display all tasks."
                );


                /*
                 * =================================================
                 * 7. HANDLE TASK WINDOW
                 * =================================================
                 */

                switchToTaskWindow();


                /*
                 * =================================================
                 * 8. GET UI TASKS
                 * =================================================
                 */

                List<WebElement> uiTaskCards =
                        driver.findElements(taskCards);


                int uiTaskCount =
                        uiTaskCards.size();


                claimTest.info(
                        "CSV Task Count : "
                                + expectedTasks.size()
                );

                claimTest.info(
                        "UI Task Count : "
                                + uiTaskCount
                );


                /*
                 * =================================================
                 * TASK COUNT VALIDATION
                 * =================================================
                 */

                if (expectedTasks.size()
                        == uiTaskCount) {

                    claimTest.pass(
                            "Task Count Validation PASSED"
                                    + "<br>CSV Task Count : "
                                    + expectedTasks.size()
                                    + "<br>UI Task Count : "
                                    + uiTaskCount
                    );

                } else {

                    claimTest.fail(
                            "Task Count Validation FAILED"
                                    + "<br>CSV Task Count : "
                                    + expectedTasks.size()
                                    + "<br>UI Task Count : "
                                    + uiTaskCount
                    );
                }


                /*
                 * =================================================
                 * 9. FIELD LEVEL VALIDATION
                 * =================================================
                 */

                validateTasks(
                        claimTest,
                        expectedTasks,
                        uiTaskCards
                );


            } catch (Exception e) {

                claimTest.fail(
                        "Claim processing failed : "
                                + e.getMessage()
                );

            } finally {

                /*
                 * Return to original claim window.
                 */

                switchToOriginalWindow();
            }
        }


        /*
         * ========================================================
         * FLUSH REPORT
         * ========================================================
         */

        extent.flush();
    }


    // ============================================================
    // SEARCH CLAIM
    // ============================================================

    private void searchClaim(
            String claimNumber) {

        WebElement searchBox =
                driver.findElement(
                        claimSearchBox
                );


        searchBox.clear();

        searchBox.sendKeys(
                claimNumber
        );


        driver.findElement(
                claimSearchButton
        ).click();


        waitForPage();
    }



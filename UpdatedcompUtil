package utilities;

import com.jayway.jsonpath.JsonPath;
import model.ValidationResult;

import java.util.List;
import java.util.Map;

public class CompareUtil {

    public static void compare(

            Map<String,
                    Map<String, String>> excelData,

            Map<String, String> jsonVersions,

            String workbookName,

            String jsonName,

            String policyNumber) {

        Map<String, String> mappings =
                JsonPathMappingUtil.getMappings();

        Map<String, String> previousFields =
                null;

        /*
         * =========================================
         * LOOP ALL VERSIONS
         * =========================================
         */

        for (String version :
                excelData.keySet()) {

            String json =
                    jsonVersions.get(version);

            if (json == null) {

                System.out.println(
                        "JSON NOT FOUND : "
                                + version);

                continue;
            }

            Map<String, String> fields =
                    excelData.get(version);

            /*
             * =========================================
             * CONTEXT VALUES
             * =========================================
             */

            String classNumber =
                    getFieldValue(
                            fields,
                            "classnumber",
                            "classnum",
                            "classno",
                            "class");

            String coverageCode =
                    getFieldValue(
                            fields,
                            "coveragecode",
                            "coverage");

            /*
             * =========================================
             * LOOP ALL EXCEL FIELDS
             * =========================================
             */

            for (String excelField :
                    fields.keySet()) {

                String expected =
                        normalize(
                                fields.get(
                                        excelField));

                String normalizedField =
                        normalizeKey(
                                excelField);

                String jsonPath = null;

                /*
                 * =====================================
                 * SMART FIELD IDENTIFICATION
                 * =====================================
                 */

                if (normalizedField.contains(
                        "classnumber")

                        ||

                        normalizedField.contains(
                                "classnum")

                        ||

                        normalizedField.contains(
                                "classno")

                        ||

                        normalizedField.equals(
                                "class")) {

                    jsonPath =
                            "$..classes"
                            + "[?(@.classNumber=='"
                            + classNumber
                            + "')]"
                            + ".classNumber";
                }

                else if (normalizedField.contains(
                        "classdescription")

                        ||

                        normalizedField.contains(
                                "classname")) {

                    jsonPath =
                            "$..classes"
                            + "[?(@.classNumber=='"
                            + classNumber
                            + "')]"
                            + ".classDescription";
                }

                else if (normalizedField.contains(
                        "fulltimehours")) {

                    jsonPath =
                            "$..classes"
                            + "[?(@.classNumber=='"
                            + classNumber
                            + "')]"
                            + ".fullTimeHours";
                }

                else if (normalizedField.contains(
                        "parttimehours")) {

                    jsonPath =
                            "$..classes"
                            + "[?(@.classNumber=='"
                            + classNumber
                            + "')]"
                            + ".partTimeHours";
                }

                else if (normalizedField.contains(
                        "coverage")) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".coverageCode";
                }

                else if (normalizedField.contains(
                        "benefittype")) {

                    jsonPath =
                            "$..benefitStructure"
                            + ".benefitTypeCode";
                }

                else if (normalizedField.contains(
                        "benefitpercent")) {

                    jsonPath =
                            "$..benefitStructure"
                            + ".benefitPercent";
                }

                else if (normalizedField.contains(
                        "maximumbenefit")) {

                    jsonPath =
                            "$..benefitStructure"
                            + ".maximumBenefit";
                }

                else if (normalizedField.contains(
                        "minimumbenefit")) {

                    jsonPath =
                            "$..benefitStructure"
                            + ".minimumBenefit";
                }

                else if (normalizedField.contains(
                        "eliminationperiod")) {

                    jsonPath =
                            "$..benefitStructure"
                            + ".eliminationPeriod";
                }

                else if (normalizedField.contains(
                        "benefitduration")) {

                    jsonPath =
                            "$..benefitStructure"
                            + ".benefitDuration";
                }

                else if (normalizedField.contains(
                        "pilot")) {

                    jsonPath =
                            "$..extendedAttributes"
                            + "[?(@.name=='pilot')]"
                            + ".value";
                }

                else if (normalizedField.contains(
                        "eoicode")

                        ||

                        normalizedField.contains(
                                "eoicd")) {

                    jsonPath =
                            "$..extendedAttributes"
                            + "[?(@.name=='eoiCd')]"
                            + ".value";
                }

                else if (normalizedField.contains(
                        "residualdisability")) {

                    jsonPath =
                            "$..extendedAttributes"
                            + "[?(@.name=='isResidualDisability')]"
                            + ".value";
                }

                else if (normalizedField.contains(
                        "agentcode")) {

                    jsonPath =
                            "$..agentCode";
                }

                else if (normalizedField.contains(
                        "subagent")) {

                    jsonPath =
                            "$..subAgentCode";
                }

                else if (normalizedField.contains(
                        "domicilestate")

                        ||

                        normalizedField.contains(
                                "situsstate")) {

                    jsonPath =
                            "$..situsState";
                }

                /*
                 * =====================================
                 * FALLBACK MAPPING FILE
                 * =====================================
                 */

                if (jsonPath == null) {

                    for (String mapKey :
                            mappings.keySet()) {

                        String normalizedMapKey =
                                normalizeKey(
                                        mapKey);

                        if (normalizedField.equals(
                                normalizedMapKey)

                                ||

                                normalizedField.contains(
                                        normalizedMapKey)

                                ||

                                normalizedMapKey.contains(
                                        normalizedField)) {

                            jsonPath =
                                    mappings.get(
                                            mapKey);

                            break;
                        }
                    }
                }

                /*
                 * =====================================
                 * VALUE BASED FALLBACK SEARCH
                 * =====================================
                 */

                if (jsonPath == null) {

                    boolean valueFound =
                            searchValueInJson(
                                    json,
                                    expected);

                    ValidationResult vr =
                            new ValidationResult();

                    vr.setPolicyNumber(
                            policyNumber);

                    vr.setVersion(
                            version);

                    vr.setFieldName(
                            excelField);

                    vr.setExpectedValue(
                            expected);

                    vr.setWorkbookFile(
                            workbookName);

                    vr.setJsonFile(
                            jsonName);

                    if (valueFound) {

                        vr.setActualValue(
                                "VALUE EXISTS IN JSON");

                        vr.setStatus(
                                "VALUE_FOUND_NO_MAPPING");

                    } else {

                        vr.setActualValue(
                                "MAPPING NOT FOUND");

                        vr.setStatus(
                                "NO_MAPPING");
                    }

                    ResultStore.results.add(
                            vr);

                    continue;
                }

                /*
                 * =====================================
                 * READ JSON VALUE
                 * =====================================
                 */

                String actual = "";

                try {

                    Object result =
                            JsonPath.read(
                                    json,
                                    jsonPath);

                    actual =
                            normalize(
                                    extractValue(
                                            result));

                } catch (Exception e) {

                    actual =
                            "JSONPATH ERROR";

                    System.out.println(
                            "FIELD : "
                                    + excelField);

                    System.out.println(
                            "PATH : "
                                    + jsonPath);

                    System.out.println(
                            e.getMessage());
                }

                /*
                 * =====================================
                 * CREATE RESULT
                 * =====================================
                 */

                ValidationResult vr =
                        new ValidationResult();

                vr.setPolicyNumber(
                        policyNumber);

                vr.setVersion(
                        version);

                vr.setFieldName(
                        excelField);

                vr.setExpectedValue(
                        expected);

                vr.setActualValue(
                        actual);

                vr.setWorkbookFile(
                        workbookName);

                vr.setJsonFile(
                        jsonName);

                if (expected.equalsIgnoreCase(
                        actual)) {

                    vr.setStatus(
                            "PASS");

                } else {

                    vr.setStatus(
                            "FAIL");
                }

                ResultStore.results.add(
                        vr);
            }

            previousFields = fields;
        }
    }

    /*
     * =========================================
     * EXTRACT VALUE
     * =========================================
     */

    private static String extractValue(
            Object result) {

        if (result == null)
            return "";

        if (result instanceof List) {

            List<?> list =
                    (List<?>) result;

            if (list.isEmpty())
                return "";

            return String.valueOf(
                    list.get(0));
        }

        return String.valueOf(
                result);
    }

    /*
     * =========================================
     * NORMALIZE VALUE
     * =========================================
     */

    private static String normalize(
            String value) {

        if (value == null)
            return "";

        return value

                .replace(".0", "")

                .replace("T00:00:00Z", "")

                .replace("\n", "")

                .replace("\r", "")

                .trim();
    }

    /*
     * =========================================
     * NORMALIZE KEY
     * =========================================
     */

    private static String normalizeKey(
            String key) {

        if (key == null)
            return "";

        return key

                .replaceAll(
                        "[^a-zA-Z0-9]",
                        "")

                .trim()

                .toLowerCase();
    }

    /*
     * =========================================
     * FLEXIBLE FIELD FETCH
     * =========================================
     */

    private static String getFieldValue(
            Map<String, String> fields,
            String... aliases) {

        for (String key :
                fields.keySet()) {

            String normalizedKey =
                    normalizeKey(
                            key);

            for (String alias :
                    aliases) {

                if (normalizedKey.contains(
                        alias.toLowerCase())) {

                    return normalize(
                            fields.get(key));
                }
            }
        }

        return "";
    }

    /*
     * =========================================
     * SEARCH VALUE IN ENTIRE JSON
     * =========================================
     */

    private static boolean searchValueInJson(
            String json,
            String expectedValue) {

        try {

            if (expectedValue == null
                    || expectedValue.isEmpty()) {

                return false;
            }

            String normalizedJson =
                    normalize(json);

            String normalizedExpected =
                    normalize(expectedValue);

            return normalizedJson
                    .toLowerCase()
                    .contains(
                            normalizedExpected
                                    .toLowerCase());

        } catch (Exception e) {

            return false;
        }
    }
}

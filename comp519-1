public class CompareUtil {

    private static int compensationIndex=0;
    private static int agencyIndex=0;
    public static void compare(Map<String, List<ExcelField>> excelData, Map<String, String> jsonVersions, String workbookName, String jsonName, String policyNumber) {
        compensationIndex=0;
        agencyIndex=0;
        List<ExcelField> previousFields = null;

        String highestVersion = getHighestVersion(excelData.keySet());

        for (String version : excelData.keySet()) {
            compensationIndex=0;
            agencyIndex=0;
            String json = jsonVersions.get(version);

            if (json == null) {

                System.out.println("JSON NOT FOUND : " + version);

                continue;
            }

            List<ExcelField> fields = excelData.get(version);

            /*
             * =====================================
             * MISSING / NEW FIELDS
             * =====================================
             */

            if (previousFields != null) {

                checkMissingAndNewFields(previousFields, fields, version, workbookName, jsonName, policyNumber);
            }

            /*
             * =====================================
             * CONTEXT VALUES
             * =====================================
             */

            String classNumber = getFieldValue(fields, "classnumber", "classnum", "classno", "class");            /*
             * =====================================
             * LOOP EXCEL FIELDS
             * =====================================
             */

            for (ExcelField field : fields) {

                String excelField = field.getFieldName();

                String expected = normalize(field.getValue());

                String normalizedField = normalizeKey(excelField);

                String actual = "";

                if (normalizedField.contains("pacsid")) {

                    actual = readJsonValue(json, "$.customer.pacsid");
                } else if (normalizedField.contains("accountdesignationtype")) {
                    actual = readJsonValue(json, "$.customer.details.accountDesignationType");
                    if (actual.equalsIgnoreCase("false") || actual.equalsIgnoreCase(""))

                        actual = "No";
                    else if (actual.equalsIgnoreCase("true")) actual = "Yes";
                } else if (normalizedField.contains("datebusinessstarted")) {

                    actual = readJsonValue(json, "$..effectiveDate");

                    actual = formatDate(actual);
                } else if (normalizedField.equals("product") || normalizedField.contains("productname") || normalizedField.contains("selectproducts")) {
                    actual = readJsonValue(json, "$..productCode");

                    if (actual.equalsIgnoreCase("LTD")) {

                        actual = "Long Term Disability";

                    } else if (actual.equalsIgnoreCase("STD")) {

                        actual = "Short Term Disability";
                    }
                } else if (normalizedField.contains("classnumber") || normalizedField.contains("classnum") || normalizedField.contains("classno") || normalizedField.equals("class")) {
                    actual = getMatchingValue(json, "$..classes[*].classNumber", expected);
                } else if (normalizedField.contains("classname") || normalizedField.contains("classdescription")) {
                    actual = getClassFieldValue(json, classNumber, "classDescription");
                } else if (normalizedField.equals("description")) {

                    actual = getClassFieldValue(json, classNumber, "description");
                } else if (normalizedField.contains("fulltimehours")) {

                    actual = getClassFieldValue(json, classNumber, "fullTimeHours");
                } else if (normalizedField.contains("parttimehours")) {

                    actual = getClassFieldValue(json, classNumber, "partTimeHours");
                } else if (normalizedField.contains("agencyagentid")) {

                    actual = getMatchingAgencyCode(json, expected);

                } else if (normalizedField.contains("subagentid")) {

                    actual = getMatchingSubAgentId(json, expected);
                } else if (normalizedField.contains("groupdomicilestate")) {

                    actual = readJsonValue(json, "$..contractStateCode");
                } else if (normalizedField.contains("originalpacspolicynumber")) {

                    actual = readJsonValue(json, "$..policySource");
                } else if (normalizedField.contains("convertedversionnumber")) {

                    actual = readJsonValue(json, "$..boSeq");
                } else if (normalizedField.contains("convertedversiontype")) {

                    actual = readJsonValue(json, "$..versionDescription");
                } else if (normalizedField.contains("convertedversiontype")) {

                    actual = readJsonValue(json, "$..versionDescription");
                } else if (normalizedField.equals("originalpacspolicyeffectivedate")) {

                    actual = readJsonValue(json, "$..effectiveDate");
                    actual = formatDate(actual);
                } else if (normalizedField.equals("convertedversioneffectivedate")) {

                    actual = readJsonValue(json, "$..inceptionDate");
                    actual = formatDate(actual);
                } else if (normalizedField.contains("supportingdata")) {

                    actual = "PACS v." + version;
                } else if (normalizedField.contains("highestpacsversionnumber")) {

                    actual = highestVersion;
                } else if (normalizedField.equals("effectivedate")) {
                    actual = getSalesRepDetails(json, "EFFECTIVEDATE");
                } else if (normalizedField.equals("effectivedate")) {
                    actual = getSalesRepDetails(json, "EFFECTIVEDATE");
                } else if (normalizedField.contains("rso")) {
                    actual = getSalesRepDetails(json, "RSO");
                } else if (normalizedField.contains("salesrepresentative")) {
                    actual = getSalesRepDetails(json, "SALESREP");
                } else if (normalizedField.contains("primary")) {
                    actual = getSalesRepDetails(json, "PRIMARY");
                } else if (normalizedField.contains("percentage")) {
                    actual = getSalesRepDetails(json, "PERCENTAGE");
                } else if (normalizedField.equals("terminationdate")) {
                    actual = getSalesRepDetails(json, "TERMINATIONDATE");
                } else if (normalizedField.equals("agencyagentname")) {
                    actual = getAgencyDetails(json, "AgencyID");
                }
                else if (normalizedField.equals("agencyname")) {
                    actual = getAgencyDetails(json, "AGENCYNAME");
                }
                else if (normalizedField.equals("subagentname")) {
                    actual = getAgencyDetails(json, "SUBAGENTNAME");
                } else if (normalizedField.equals("writingagent")) {
                    actual = getAgencyDetails(json, "WRITINGAGENT");
                } else if (normalizedField.equals("responsibleagent")) {
                    actual = getAgencyDetails(json, "RESPONSIBLEAGENT");
                } else if (normalizedField.equals("compensationschedule")) {
                    actual = getAgencyDetails(json, "COMPENSATIONSCHEDULE");
                } else if (normalizedField.equals("sharepercentage")) {
                    actual = getAgencyDetails(json, "SHARE PERCENTAGE");
                } else if (normalizedField.equals("agencyagenteffectivedate")) {
                    actual = getAgencyDetails(json, "EFFECTIVEDATE");

                } else if (normalizedField.equals("compensationruletype")) {
                    actual = getAgencyDetails(json, "COMP_RULE_TYPE");

                } else if (normalizedField.equals("plancode")) {
                    actual = getAgencyDetails(json, "Plan Code");

                } else if (normalizedField.equals("comp")) {
                    actual = getAgencyDetails(json, "COMPPERCENT");

                } else if (normalizedField.equals("comp")) {
                    actual = getAgencyDetails(json, "COMP_PERCENT");

                } else if (normalizedField.contains("subagenciesid")) {
                    String subName = getAgencyDetails(json, "SUBAGENTNAME");
                    if (!(subName == null)) {
                        actual = getMatchingSubAgentId(json, expected);
                    } else {
                        actual = "";
                    }
                }


                /*
                 * =====================================
                 * NO MAPPING
                 * =====================================
                 */

                else {

                    actual = "MAPPING NOT FOUND";
                }

                /*
                 * =====================================
                 * RESULT
                 * =====================================
                 */

                ValidationResult vr = new ValidationResult();

                vr.setPolicyNumber(policyNumber);

                vr.setVersion(version);

                vr.setFieldName(excelField);

                vr.setExpectedValue(expected);

                vr.setActualValue(actual);

                vr.setWorkbookFile(workbookName);

                vr.setJsonFile(jsonName);

                if (normalize(expected).equalsIgnoreCase(normalize(actual))) {
                    vr.setStatus("PASS");

                } else {

                    vr.setStatus("FAIL");
                }

                ResultStore.results.add(vr);
            }

            previousFields = fields;
        }
    }

    private static String getClassFieldValue(String json, String classNumber, String fieldName) {
        try {

            List<Map<String, Object>> classes = JsonPath.read(json, "$..classes[*]");
            for (Map<String, Object> cls : classes) {

                Object clsNum = cls.get("classNumber");

                if (clsNum == null) continue;

                if (normalize(String.valueOf(clsNum)).equalsIgnoreCase(normalize(classNumber))) {

                    Object value = cls.get(fieldName);

                    return value == null ? "" : normalize(String.valueOf(value));
                }
            }

        } catch (Exception e) {

            e.printStackTrace();
        }

        return "";
    }

    private static String getMatchingValue(String json, String jsonPath, String expected) {

        try {

            List<Object> values = JsonPath.read(json, jsonPath);
            for (Object obj : values) {

                if (obj == null) continue;

                String value = normalize(String.valueOf(obj));

                if (value.equalsIgnoreCase(normalize(expected))) {

                    return value;
                }
            }

        } catch (Exception e) {

            e.printStackTrace();
        }

        return "";
    }


    private static String readJsonValue(String json, String jsonPath) {
        try {

            Object result = JsonPath.read(json, jsonPath);

            if (result == null) return "";

            if (result instanceof List) {

                List<?> list = (List<?>) result;

                if (list.isEmpty()) return "";

                return normalize(String.valueOf(list.get(0)));
            }

            return normalize(String.valueOf(result));

        } catch (Exception e) {

            return "";
        }
    }


    private static String getMatchingAgencyCode(String json, String expected) {
        try {

            List<Map<String, Object>> splitParts = JsonPath.read(json, "$.premiumSplit.splitParts[*]");
            for (Map<String, Object> splitPart : splitParts) {

                List<Map<String, Object>> details = (List<Map<String, Object>>) splitPart.get("premiumSplitDetails");
                if (details == null) continue;

                for (Map<String, Object> detail : details) {

                    Map<String, Object> broker = (Map<String, Object>) detail.get("broker");
                    if (broker == null) continue;
                    Object agencyCodeObj = broker.get("agencyCode");
                    if (agencyCodeObj == null) continue;

                    String agencyCode = normalize(String.valueOf(agencyCodeObj));
                    if (agencyCode.equalsIgnoreCase(normalize(expected))) {
                        return agencyCode;
                    }

                }
            }

        } catch (Exception e) {

            e.printStackTrace();
        }

        return "";
    }


    private static String getAgencyDetails(String json, String type) {

        try {


            List<Map<String, Object>> splitParts = JsonPath.read(json, "$.premiumSplit.splitParts[*]");

            if(splitParts==null)
                return "";
            for (Map<String, Object> splitPart : splitParts) {

                List<Map<String, Object>> details = (List<Map<String, Object>>) splitPart.get("premiumSplitDetails");

                if (details==null)
               continue;
               

                for (Map<String, Object> detail : details) {

                    Map<String, Object> broker = (Map<String, Object>) detail.get("broker");

                    if (broker == null) continue;

                    /*
                     * MATCH AGENCY CODE
                     */


                    if (type.equalsIgnoreCase(normalize("AgencyID"))) {
                        Object value = broker.get("agencyCode");
                        return value == null ? "" : normalize(value.toString());
                    }

                    /*
                     * AGENCY/AGENT NAME
                     */

                    if (type.equalsIgnoreCase("AGENCYNAME")) {
                        Object value =broker.get("agencyName");
                        return value == null ? "" : normalize(value.toString());
                    }

                    /*
                     * SUB AGENT NAME
                     */

                    else if (type.equalsIgnoreCase("SUBAGENTNAME")) {
                        Object value =broker.get("agentName");
                        return value == null ? "" : normalize(value.toString());
                    }

                    /*
                     * WRITING AGENT
                     */

                    else if (type.equalsIgnoreCase("WRITINGAGENT")) {
                        Object value =broker.get("isPrimary");
                        return value == null ? "" : normalize(value.toString());
                    }

                    /*
                     * RESPONSIBLE AGENT
                     */

                    else if (type.equalsIgnoreCase("RESPONSIBLEAGENT")) {
                        Object value =broker.get("isResponsibleAgent");
                        return value == null ? "" : normalize(value.toString());
                    }

                    /*
                     * EFFECTIVE DATE
                     */

                    else if (type.equalsIgnoreCase("EFFECTIVEDATE")) {
                        Object value =broker.get("effectiveDate");
                        value=formatDate((String) value);
                        return value == null ? "" : normalize(value.toString());

                    }

                    /*
                     * COMPENSATION SCHEDULE
                     */

                    else if (type.equalsIgnoreCase("COMPENSATIONSCHEDULE")) {
                        List<String> values=new ArrayList<>();
                        Object value =detail.get("compensationTypeCode");
                       if(value!=null)
                       {
                           values.add(normalize(value.toString()));
                       }
                       if(values.isEmpty())
                       {
                           return "";
                       }
                       if(compensationIndex>=values.size())
                       {

                           compensationIndex=0;
                       }
                        String result=values.get(compensationIndex);
                       compensationIndex++;
                       return result;
                    }
                    else if (type.equalsIgnoreCase("SHARE PERCENTAGE")) {
                        Object value =detail.get("compensationSplitParentAgencyPercent");
                        return value == null ? "" : normalize(value.toString());

                    } else if (type.equalsIgnoreCase("COMP_RULE_TYPE")) {

                        Map<String, Object> contractAssignment = (Map<String, Object>) detail.get("contractAssignment");
                        if (contractAssignment != null) {

                            Map<String, Object> commissionCalculation = (Map<String, Object>) contractAssignment.get("commissionCalculation");

                            if (commissionCalculation != null) {

                                Object value = commissionCalculation.get("type");

                                return value == null ? "" : normalize(value.toString());
                            }
                        }
                    } else if (type.equalsIgnoreCase("Plan Code")) {

                        Map<String, Object> contractAssignment = (Map<String, Object>) detail.get("contractAssignment");
                        if (contractAssignment != null) {

                            Map<String, Object> commissionCalculation = (Map<String, Object>) contractAssignment.get("commissionCalculation");

                            if (commissionCalculation != null) {

                                Object value = commissionCalculation.get("planCode");

                                return value == null ? "" : normalize(value.toString());
                            }
                        }
                    }

                    /*
                     * COMP %
                     */

                    else if (type.equalsIgnoreCase("COMPPERCENT")) {

                        Map<String, Object> contract = (Map<String, Object>) detail.get("contractAssignment");

                        if (contract == null) return "";

                        Map<String, Object> calc = (Map<String, Object>) contract.get("commissionCalculation");

                        if (calc == null) return "";
                        Map<String, Object> comp = (Map<String, Object>) calc.get("commissionRate");
                        {
                            Object value = comp.get("rate");
                            return value == null ? "" : normalize(value.toString());
                        }


                    }
                }
            }

        } catch (Exception e) {

            e.printStackTrace();
        }

        return "";
    }

    private static String getMatchingSubAgentId(String json, String expected) {

        try {

            List<Map<String, Object>> splitParts = JsonPath.read(json, "$.premiumSplit.splitParts[*]");

            for (Map<String, Object> splitPart : splitParts) {

                List<Map<String, Object>> details = (List<Map<String, Object>>) splitPart.get("premiumSplitDetails");

                if (details == null) continue;

                for (Map<String, Object> detail : details) {

                    Map<String, Object> broker = (Map<String, Object>) detail.get("broker");

                    if (broker == null) continue;

                    Object agentCodeObj = broker.get("agentCode");
                    if (agentCodeObj == null) continue;

                    String agentCode = normalize(String.valueOf(agentCodeObj)).replace("-", "");

                    if (agentCode.equalsIgnoreCase(normalize(expected))) {

                        return agentCode;
                    }
                }
            }

        } catch (Exception e) {

            e.printStackTrace();
        }

        return "";
    }

    private static String getSalesRepDetails(String json, String type) {
        StringBuilder result = new StringBuilder();
        try {
            List<Map<String, Object>> rsos = JsonPath.read(json, "$.regionalSalesOffices[?(@.terminationDate == null)]");
//           System.out.println("Active rso's " + rsos.size());
            if (rsos == null || rsos.isEmpty()) {
                return "";
            }
            for (Map<String, Object> rso : rsos) {
                String rsoCode = normalize(String.valueOf(rso.get("rsoCode")));

                Object rsoTermination = rso.get("terminationDate");
                String terminationDate = rsoTermination == null ? "" : normalize(rsoTermination.toString());
                terminationDate = formatDate(terminationDate);

                List<Map<String, Object>> reps = (List<Map<String, Object>>) rso.get("salesRepresentatives");
                if (reps == null) continue;
                for (Map<String, Object> rep : reps) {
                    String value = "";

                    if (type.equalsIgnoreCase("RSO")) {
                        value = rsoCode;
                    } else if (type.equalsIgnoreCase("SALESREP")) {
                        Object salesRepObj = rep.get("salesRep");
                        if (salesRepObj == null) continue;
                        value = normalize(salesRepObj.toString());
                        if (value.contains("(")) {
                            value = value.substring(0, value.indexOf("(")).trim();
                        }
                    } else if (type.equalsIgnoreCase("PRIMARY")) {
                        Object primaryObj = rep.get("isPrimary");
                        if (primaryObj == null) continue;
                        value = normalize(primaryObj.toString());

                    } else if (type.equalsIgnoreCase("PERCENTAGE")) {
                        Object percentageObj = rep.get("percentage");
                        if (percentageObj == null) continue;
                        value = normalize(percentageObj.toString());

                    } else if (type.equalsIgnoreCase("TERMINATIONDATE")) {

                        value = terminationDate;

                    } else if (type.equalsIgnoreCase("EFFECTIVEDATE")) {

                        Object effectiveObj = rep.get("effectiveDate");
                        if (effectiveObj == null) continue;
                        value = normalize(effectiveObj.toString());
                        value = formatDate(value);

                    }
                    if (value != null && !value.isEmpty()) {
                        if (result.length() > 0) {
                            result.append(",");
                        }
                        result.append(value);
                    }
                }
            }
        } catch (Exception e) {
            e.printStackTrace();
        }
        return result.toString();
    }



    /*
     * =========================================
     * MISSING / NEW FIELDS
     * =========================================
     */

    private static void checkMissingAndNewFields(List<ExcelField> previousFields, List<ExcelField> currentFields, String version, String workbookName, String jsonName, String policyNumber) {
        for (ExcelField previous : previousFields) {

            boolean found = false;

            for (ExcelField current : currentFields) {

                if (normalizeKey(previous.getFieldName())

                        .equalsIgnoreCase(normalizeKey(current.getFieldName()))) {

                    found = true;

                    break;
                }
            }

            if (!found) {

                ValidationResult vr = new ValidationResult();

                vr.setPolicyNumber(policyNumber);

                vr.setVersion(version);

                vr.setFieldName(previous.getFieldName());

                vr.setExpectedValue(previous.getValue());

                vr.setActualValue("FIELD MISSING");

                vr.setStatus("MISSING_IN_CURRENT_VERSION");

                vr.setWorkbookFile(workbookName);

                vr.setJsonFile(jsonName);

                ResultStore.results.add(vr);
            }
        }
    }


package utilities;

import java.io.File;
import java.util.Map;

public class PolicyComparisonManager {

    public static void execute()
            throws Exception {

        Map<File, File> files =
                FileMatcherUtil
                        .getMatchedFiles();

        for (Map.Entry<File, File> entry
                : files.entrySet()) {

            File workbook =
                    entry.getKey();

            File json =
                    entry.getValue();

            System.out.println(
                    "\n#################################");

            System.out.println(
                    "WORKBOOK : "
                            + workbook.getName());

            System.out.println(
                    "JSON : "
                            + json.getName());

            System.out.println(
                    "#################################");

            Map<String,
                    Map<String, String>> excelData =

                    ExcelUtil.readWorkbook(
                            workbook.getAbsolutePath());

            Map<String, String> jsonData =

                    JsonUtil.getPolicyJsonMap(
                            json.getAbsolutePath());

            CompareUtil.compare(
                    excelData,
                    jsonData);
        }
    }
}

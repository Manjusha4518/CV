    private static String getSalesRepDetails(String json,String type) {
       StringBuilder result=new StringBuilder();
       try{
           List<Map<String,Object>> rsos=JsonPath.read(json,"$.regionalSalesOffices[?(@.terminationDate == null)]");
//           System.out.println("Active rso's " + rsos.size());
      if(rsos==null||rsos.isEmpty())
      {
          return "";
      }
      for(Map<String,Object> rso:rsos)
      {
          String rsoCode=normalize(String.valueOf(rso.get("rsoCode")));

          Object rsoTermination=rso.get("terminationDate");
          String terminationDate=rsoTermination==null
                  ?""
                  :normalize(rsoTermination.toString());
          terminationDate=formatDate(terminationDate);

          List<Map<String,Object>> reps=(List<Map<String,Object>>)rso.get("salesRepresentatives");
          if(reps==null)
              continue;
          for(Map<String,Object>rep:reps)
          {
              String value="";

              if(type.equalsIgnoreCase("RSO")){
                  value=rsoCode;
              }
             else if(type.equalsIgnoreCase("SALESREP")){
                 Object salesRepObj=rep.get("salesRep");
                 if(salesRepObj==null)
                 continue;
                 value=normalize(salesRepObj.toString());
                 if(value.contains("("))
                 {
                     value=value.substring(0,value.indexOf("(")).trim();
                 }
              }
              else if(type.equalsIgnoreCase("PRIMARY")){
                  Object primaryObj=rep.get("isPrimary");
                  if(primaryObj==null)
                      continue;
                  value=normalize(primaryObj.toString());

              }
              else if(type.equalsIgnoreCase("PERCENTAGE")){
                  Object percentageObj=rep.get("percentage");
                  if(percentageObj==null)
                      continue;
                  value=normalize(percentageObj.toString());

              }
              else if(type.equalsIgnoreCase("TERMINATIONDATE")){

                  value=terminationDate;

              }
              else if(type.equalsIgnoreCase("EFFECTIVEDATE")){

                  Object effectiveObj=rep.get("effectiveDate");
                  if(effectiveObj==null)
                      continue;
                  value=normalize(effectiveObj.toString());
                  value=formatDate(value);

              }
              if(value!=null && !value.isEmpty())
              {
                  if(result.length()>0)
                  {
                      result.append(",");
                  }
                  result.append(value);
              }
          }
      }
       }catch (Exception e)
       {
           e.printStackTrace();
       }
       return result.toString();
    }



    /*
     * =========================================
     * MISSING / NEW FIELDS
     * =========================================
     */

    private static void checkMissingAndNewFields(List<ExcelField> previousFields, List<ExcelField> currentFields, String version, String workbookName, String jsonName, String policyNumber) {
        for (ExcelField previous : previousFields) {

            boolean found = false;

            for (ExcelField current : currentFields) {

                if (normalizeKey(previous.getFieldName())

                        .equalsIgnoreCase(normalizeKey(current.getFieldName()))) {

                    found = true;

                    break;
                }
            }

            if (!found) {

                ValidationResult vr = new ValidationResult();

                vr.setPolicyNumber(policyNumber);

                vr.setVersion(version);

                vr.setFieldName(previous.getFieldName());

                vr.setExpectedValue(previous.getValue());

                vr.setActualValue("FIELD MISSING");

                vr.setStatus("MISSING_IN_CURRENT_VERSION");

                vr.setWorkbookFile(workbookName);

                vr.setJsonFile(jsonName);

                ResultStore.results.add(vr);
            }
        }
    }

    /*
     * =========================================
     * GET FIELD VALUE
     * =========================================
     */

    private static String getFieldValue(List<ExcelField> fields, String... aliases) {

        for (ExcelField ef : fields) {

            String fieldName = normalizeKey(ef.getFieldName());

            for (String alias : aliases) {

                if (fieldName.contains(normalizeKey(alias))) {

                    return normalize(ef.getValue());
                }
            }
        }

        return "";
    }

    /*
     * =========================================
     * FORMAT DATE
     * =========================================
     */

    private static String formatDate(String input) {

        try {

            if (input.contains("T")) {

                input = input.substring(0, 10);
            }

            SimpleDateFormat in = new SimpleDateFormat("yyyy-MM-dd");

            SimpleDateFormat out = new SimpleDateFormat("MM/dd/yyyy");

            Date d = in.parse(input);

            return out.format(d);

        } catch (Exception e) {

            return input;
        }
    }

    /*
     * =========================================
     * NORMALIZE
     * =========================================
     */

    private static String normalize(String value) {

        if (value == null) return "";

        value = value.trim();

        if (value.endsWith(".0")) {

            value = value.substring(0, value.length() - 2);
        }

        try {

            if (value.contains("E") || value.contains("e")) {

                BigDecimal bd = new BigDecimal(value);

                value = bd.toPlainString();
            }

        } catch (Exception e) {
        }

        return value

                .replace("\n", "")

                .replace("\r", "")

                .replace("T00:00:00Z", "")

                .trim();
    }

    /*
     * =========================================
     * NORMALIZE KEY
     * =========================================
     */

    private static String normalizeKey(String key) {

        if (key == null) return "";

        return key

                .replaceAll("[^a-zA-Z0-9]", "")

                .trim()

                .toLowerCase();
    }
    private static String getHighestVersion(Set<String> versions) {

        int highest=Integer.MIN_VALUE;
        for(String version: versions)
        {
            try{
                int value=Integer.parseInt(version.replaceAll("[^0-9]",""));
                if(value>highest)
                {
                    highest=value;
                }
            }catch (Exception e){

            }
        }
        if (highest==Integer.MIN_VALUE){
            return "";
        }
        return String.valueOf(highest);
    }

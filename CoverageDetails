private static String getCoverageDetails(String json, String type) {

    try {

        List<Map<String, Object>> plans =
                JsonPath.read(json, "$.plans[*]");

        if (plans == null || plans.isEmpty()) {

            return "FIELD NOT FOUND";
        }

        /*
         * ============================
         * PLAN ROW
         * ============================
         */

        if (type.equalsIgnoreCase("PLAN")) {

            if (currentPlanIndex >= plans.size()) {

                return "FIELD NOT FOUND";
            }

            activePlanIndex = currentPlanIndex;

            Map<String, Object> plan =
                    plans.get(currentPlanIndex);

            Object obj = plan.get("planName");

            currentCoverageIndex = 0;

            currentPlanIndex++;

            return obj == null
                    ? "FIELD NOT FOUND"
                    : normalize(obj.toString());
        }

        /*
         * ============================
         * CURRENT ACTIVE PLAN
         * ============================
         */

        if (activePlanIndex >= plans.size()) {

            return "FIELD NOT FOUND";
        }

        Map<String, Object> plan =
                plans.get(activePlanIndex);

        List<Map<String, Object>> coverages =
                (List<Map<String, Object>>) plan.get("coverages");

        if (coverages == null || coverages.isEmpty()) {

            return "FIELD NOT FOUND";
        }

        if (currentCoverageIndex >= coverages.size()) {

            currentCoverageIndex = 0;
        }

        Map<String, Object> coverage =
                coverages.get(currentCoverageIndex);

        String value = "";

        /*
         * COVERAGE
         */

        if (type.equalsIgnoreCase("COVERAGE")) {

            Object obj = coverage.get("coverageName");

            value = obj == null
                    ? ""
                    : normalize(obj.toString());
        }

        /*
         * CLASS SELECTION CLASS
         */

        else if (type.equalsIgnoreCase("CLASSSELECTIONCLASS")) {

            Object obj = coverage.get("classSelectionClass");

            value = obj == null
                    ? ""
                    : normalize(obj.toString());
        }

        /*
         * CONTRIBUTION TYPE
         */

        else if (type.equalsIgnoreCase("CONTRIBUTIONTYPE")) {

            Map<String, Object> funding =
                    (Map<String, Object>)
                            coverage.get("fundingStructure");

            if (funding != null) {

                Object obj =
                        funding.get("contributionType");

                value = obj == null
                        ? ""
                        : normalize(obj.toString());
            }
        }

        /*
         * EMPLOYEE CONTRIBUTION
         */

        else if (type.equalsIgnoreCase("EMPLOYEECONTRIBUTION")) {

            Map<String, Object> funding =
                    (Map<String, Object>)
                            coverage.get("fundingStructure");

            if (funding != null) {

                Object obj =
                        funding.get("employeeContributionPercent");

                value = obj == null
                        ? ""
                        : normalize(obj.toString());
            }
        }

        /*
         * EMPLOYER CONTRIBUTION
         */

        else if (type.equalsIgnoreCase("EMPLOYERCONTRIBUTION")) {

            Map<String, Object> funding =
                    (Map<String, Object>)
                            coverage.get("fundingStructure");

            if (funding != null) {

                Object obj =
                        funding.get("employerContributionPercent");

                value = obj == null
                        ? ""
                        : normalize(obj.toString());
            }
        }

        /*
         * MOVE NEXT COVERAGE
         */

        currentCoverageIndex++;

        return value == null || value.isEmpty()
                ? "FIELD NOT FOUND"
                : value;

    } catch (Exception e) {

        e.printStackTrace();

        return "FIELD NOT FOUND";
    }
}

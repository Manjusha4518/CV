                return obj == null ? "" : formatDate(obj.toString());
            } else if (type.equalsIgnoreCase("EnrollmentGuidelinesApplyTo")) {

                Object obj = enrollment.get("guidelinesApplyTo");

                return obj == null ? "" : (obj.toString());
            } else if (type.equalsIgnoreCase("EnrollmentGuidelinesApplyToName")) {

                Object obj = enrollment.get("name");

                return obj == null ? "" : (obj.toString());
            } else if (type.equalsIgnoreCase("NamesOfTheAffiliates")) {

                Object obj = enrollment.get("NamesOfTheAffiliates");

                if (obj instanceof List) {
                    List<?> list = (List<?>) obj;

                    if (list.isEmpty()) {
                        return "";
                    }

                    return list.get(0).toString(); // or join if multiple
                }

                return "";
            } else if (type.equalsIgnoreCase("ContractClasses")) {

                Object obj = enrollment.get("contractClasses");

                if (obj instanceof List) {
                    List<?> list = (List<?>) obj;

                    if (list.isEmpty()) {
                        return "";
                    }

                    return list.get(0).toString();
                }

                return "";

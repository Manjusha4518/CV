    private static String getEnrollmentDetails(String json, String type) {

        StringBuilder result = new StringBuilder();

        try {
            List<Map<String, Object>> enrollments = JsonPath.read(json, "$.enrollmentDetails[*]");

            if (enrollments == null || enrollments.isEmpty()) {

                return "";
            }

            if (type.equalsIgnoreCase("RecordNumber")) {
                enrollIndex++;
                if (enrollIndex >= enrollments.size()) {
                    return "";
                }
            }
            int currentIndex = enrollIndex < 0 ? 0 : enrollIndex;
            if (currentIndex >= enrollments.size()) {
                return "";
            }
            Map<String, Object> enrollment = enrollments.get(currentIndex);

            if (type.equalsIgnoreCase("RecordNumber")) {

                Object obj = enrollment.get("recordNumber");

                return obj == null ? "" : normalize(obj.toString());
            } else if (type.equalsIgnoreCase("TypeOfEnrollment")) {

                Object obj = enrollment.get("type");


                return obj.toString();
            } else if (type.equalsIgnoreCase("ApplicableCoverages")) {

                Object obj = enrollment.get("applicableCoverages");

                if (obj instanceof List) {
                    List<?> coverages = (List<?>) obj;

                    if (coverages.isEmpty()) {
                        return "";
                    }
                    return coverages.get(0).toString();

                }

                return "";
            } else if (type.equalsIgnoreCase("EnrollmentStartDate")) {

                Object obj = enrollment.get("startDate");

                return obj == null ? "" : formatDate(obj.toString());
            } else if (type.equalsIgnoreCase("EnrollmentEndDate")) {


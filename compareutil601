    private static String getAgencyAgentDetails(String json, String type, String expected) {

        try {

            List<Map<String, Object>> agencies = JsonPath.read(json, "$.agencies[*]");

            if (agencies == null || agencies.isEmpty()) {
                return "";
            }

            String expectedNormalized = normalize(expected);

            for (Map<String, Object> agency : agencies) {

                String subAgentId = agency.get("subAgentID") == null ? "" : agency.get("subAgentID").toString().trim();

                String agencyCode = agency.get("agencyCode") == null ? "" : agency.get("agencyCode").toString().trim();


                if (type.equalsIgnoreCase("AgencyAgentID")) {

                    // Only main agencies
                    if ("0000".equals(subAgentId)) {

                        String val = normalize(agencyCode);

                        if (val.equalsIgnoreCase(expectedNormalized)) {
                            return val;
                        }
                    }
                }


                else if (type.equalsIgnoreCase("SubAgentID")) {

                    // Only sub-agents
                    if (!"0000".equals(subAgentId) && !subAgentId.isEmpty()) {

                        String combined = normalize(agencyCode + subAgentId);

                        if (combined.equalsIgnoreCase(expectedNormalized)) {
                            return combined;
                        }
                    }
                }
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return "";
    }


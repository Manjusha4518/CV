    private static String getERISADetails(String json, String type) {

        try {
            Map<String, Object> erisa = JsonPath.read(json, "$.erisa");

            if (erisa == null || erisa.isEmpty()) {
                return "";
            }

            if (type.equalsIgnoreCase("SPDERISAInfo")) {

                Object obj = erisa.get("planName");

                if (obj == null) return "";

                if ("SPD".equals(obj.toString())) {
                    return "SPD";
                } else if ("".equals(obj.toString()) || " ".equals(obj.toString()) || "null".equals(obj.toString()) || "Full Erisa".equals(obj.toString())) {
                    return "Full ERISA";
                } else {
                    return obj.toString();
                }

            } else if (type.equalsIgnoreCase("ERISAPlanNumber")) {

                Object obj = erisa.get("erisaPlanNumber");

                return obj == null ? "" : normalize(obj.toString());

            } else if (type.equalsIgnoreCase("RecordBasis")) {

                Object obj = erisa.get("recordBasis");

                return obj == null ? "" : normalize(obj.toString());

            } else if (type.equalsIgnoreCase("MonthDayMMDD")) {

                Object obj = erisa.get("monthDay");

                return obj == null ? "" : obj.toString();
            }

        } catch (Exception e) {
            e.printStackTrace();
        }

        return "";
    }


package utilities;

import com.jayway.jsonpath.JsonPath;
import model.ValidationResult;

import java.util.List;
import java.util.Map;

public class CompareUtil {

    public static void compare(

            Map<String,
                    Map<String, String>> excelData,

            Map<String, String> jsonVersions,

            String workbookName,

            String jsonName,

            String policyNumber) {

        Map<String, String> mappings =
                JsonPathMappingUtil.getMappings();

        Map<String, String> previousFields =
                null;

        /*
         * =====================================
         * LOOP ALL VERSIONS
         * =====================================
         */

        for (String version :
                excelData.keySet()) {

            String json =
                    jsonVersions.get(version);

            if (json == null) {

                System.out.println(
                        "JSON NOT FOUND : "
                                + version);

                continue;
            }

            Map<String, String> fields =
                    excelData.get(version);

            /*
             * =====================================
             * VERSION DIFFERENCE CHECK
             * =====================================
             */

            if (previousFields != null) {

                for (String previousField :
                        previousFields.keySet()) {

                    if (!fields.containsKey(
                            previousField)) {

                        ValidationResult vr =
                                new ValidationResult();

                        vr.setPolicyNumber(
                                policyNumber);

                        vr.setVersion(
                                version);

                        vr.setFieldName(
                                previousField);

                        vr.setExpectedValue(
                                previousFields.get(
                                        previousField));

                        vr.setActualValue(
                                "FIELD NOT PRESENT");

                        vr.setStatus(
                                "MISSING_IN_CURRENT_VERSION");

                        vr.setWorkbookFile(
                                workbookName);

                        vr.setJsonFile(
                                jsonName);

                        ResultStore.results.add(
                                vr);
                    }
                }

                for (String currentField :
                        fields.keySet()) {

                    if (!previousFields.containsKey(
                            currentField)) {

                        ValidationResult vr =
                                new ValidationResult();

                        vr.setPolicyNumber(
                                policyNumber);

                        vr.setVersion(
                                version);

                        vr.setFieldName(
                                currentField);

                        vr.setExpectedValue(
                                "FIELD NOT IN PREVIOUS VERSION");

                        vr.setActualValue(
                                fields.get(
                                        currentField));

                        vr.setStatus(
                                "NEW_FIELD_IN_CURRENT_VERSION");

                        vr.setWorkbookFile(
                                workbookName);

                        vr.setJsonFile(
                                jsonName);

                        ResultStore.results.add(
                                vr);
                    }
                }
            }

            /*
             * =====================================
             * CONTEXT VALUES
             * =====================================
             */

            String classNumber =
                    getFieldValue(
                            fields,
                            "Class Number",
                            "Class No",
                            "Class #",
                            "Class",
                            "Class Num");

            String coverageCode =
                    getFieldValue(
                            fields,
                            "Coverage Code",
                            "Coverage",
                            "Coverage Cd");

            String benefitType =
                    getFieldValue(
                            fields,
                            "Benefit Type",
                            "Benefit");

            /*
             * =====================================
             * LOOP EXCEL FIELDS
             * =====================================
             */

            for (String excelField :
                    fields.keySet()) {

                String expected =
                        normalize(
                                fields.get(
                                        excelField));

                /*
                 * =====================================
                 * FIND MAPPING
                 * =====================================
                 */

                String jsonPath = null;

                String normalizedField =
                        normalizeKey(
                                excelField);

                for (String mapKey :
                        mappings.keySet()) {

                    String normalizedMapKey =
                            normalizeKey(
                                    mapKey);

                    if (normalizedField.equals(
                            normalizedMapKey)) {

                        jsonPath =
                                mappings.get(
                                        mapKey);

                        break;
                    }
                }

                /*
                 * =====================================
                 * DYNAMIC PATHS
                 * =====================================
                 */

                if ("DYNAMIC_CLASS_NUMBER"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".classes"
                            + "[?(@.classNumber=="
                            + classNumber
                            + ")]"
                            + ".classNumber";
                }

                else if ("DYNAMIC_CLASS_DESCRIPTION"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".classes"
                            + "[?(@.classNumber=="
                            + classNumber
                            + ")]"
                            + ".classDescription";
                }

                else if ("DYNAMIC_FULL_TIME_HOURS"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".classes"
                            + "[?(@.classNumber=="
                            + classNumber
                            + ")]"
                            + ".fullTimeHours";
                }

                else if ("DYNAMIC_PART_TIME_HOURS"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".classes"
                            + "[?(@.classNumber=="
                            + classNumber
                            + ")]"
                            + ".partTimeHours";
                }

                else if ("DYNAMIC_COVERAGE_CODE"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".coverageCode";
                }

                else if ("DYNAMIC_COVERAGE_TYPE"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".coverageType";
                }

                else if ("DYNAMIC_COVERAGE_STATUS"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".coverageStatus";
                }

                else if ("DYNAMIC_BENEFIT_TYPE"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".benefitStructure"
                            + ".benefitTypeCode";
                }

                else if ("DYNAMIC_BENEFIT_PERCENT"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".benefitStructure"
                            + ".benefitPercent";
                }

                else if ("DYNAMIC_MAXIMUM_BENEFIT"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".benefitStructure"
                            + ".maximumBenefit";
                }

                else if ("DYNAMIC_MINIMUM_BENEFIT"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".benefitStructure"
                            + ".minimumBenefit";
                }

                else if ("DYNAMIC_ELIMINATION_PERIOD"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".benefitStructure"
                            + ".eliminationPeriod";
                }

                else if ("DYNAMIC_BENEFIT_DURATION"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".benefitStructure"
                            + ".benefitDuration";
                }

                else if ("DYNAMIC_PILOT"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".benefitStructure"
                            + ".extendedAttributes"
                            + "[?(@.name=='pilot')]"
                            + ".value";
                }

                else if ("DYNAMIC_EOI_CODE"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".benefitStructure"
                            + ".extendedAttributes"
                            + "[?(@.name=='eoiCd')]"
                            + ".value";
                }

                else if ("DYNAMIC_RESIDUAL_DISABILITY"
                        .equals(jsonPath)) {

                    jsonPath =
                            "$..coverages"
                            + "[?(@.coverageCode=='"
                            + coverageCode
                            + "')]"
                            + ".benefitStructure"
                            + ".extendedAttributes"
                            + "[?(@.name=='isResidualDisability')]"
                            + ".value";
                }

                /*
                 * =====================================
                 * NO MAPPING
                 * =====================================
                 */

                if (jsonPath == null) {

                    ValidationResult vr =
                            new ValidationResult();

                    vr.setPolicyNumber(
                            policyNumber);

                    vr.setVersion(
                            version);

                    vr.setFieldName(
                            excelField);

                    vr.setExpectedValue(
                            expected);

                    vr.setActualValue(
                            "MAPPING NOT FOUND");

                    vr.setStatus(
                            "NO_MAPPING");

                    vr.setWorkbookFile(
                            workbookName);

                    vr.setJsonFile(
                            jsonName);

                    ResultStore.results.add(
                            vr);

                    continue;
                }

                /*
                 * =====================================
                 * READ JSON
                 * =====================================
                 */

                String actual = "";

                try {

                    Object result =
                            JsonPath.read(
                                    json,
                                    jsonPath);

                    actual =
                            normalize(
                                    extractValue(
                                            result));

                } catch (Exception e) {

                    actual =
                            "JSONPATH ERROR";

                    System.out.println(
                            "ERROR FIELD : "
                                    + excelField);

                    System.out.println(
                            "JSONPATH : "
                                    + jsonPath);

                    System.out.println(
                            e.getMessage());
                }

                /*
                 * =====================================
                 * CREATE RESULT
                 * =====================================
                 */

                ValidationResult vr =
                        new ValidationResult();

                vr.setPolicyNumber(
                        policyNumber);

                vr.setVersion(
                        version);

                vr.setFieldName(
                        excelField);

                vr.setExpectedValue(
                        expected);

                vr.setActualValue(
                        actual);

                vr.setWorkbookFile(
                        workbookName);

                vr.setJsonFile(
                        jsonName);

                /*
                 * =====================================
                 * FINAL STATUS
                 * =====================================
                 */

                if (expected.equalsIgnoreCase(
                        actual)) {

                    vr.setStatus(
                            "PASS");

                } else {

                    vr.setStatus(
                            "FAIL");
                }

                ResultStore.results.add(
                        vr);
            }

            previousFields = fields;
        }
    }

    /*
     * =====================================
     * EXTRACT VALUES
     * =====================================
     */

    private static String extractValue(
            Object result) {

        if (result == null)
            return "";

        if (result instanceof List) {

            List<?> list =
                    (List<?>) result;

            if (list.isEmpty())
                return "";

            return list.get(0)
                    .toString();
        }

        return result.toString();
    }

    /*
     * =====================================
     * NORMALIZE VALUE
     * =====================================
     */

    private static String normalize(
            String value) {

        if (value == null)
            return "";

        value = value.trim();

        value = value.replace(
                ".0",
                "");

        value = value.replace(
                "T00:00:00Z",
                "");

        return value;
    }

    /*
     * =====================================
     * NORMALIZE FIELD NAME
     * =====================================
     */

    private static String normalizeKey(
            String key) {

        return key.trim()
                .replace(":", "")
                .replace("-", "")
                .replace("_", "")
                .replace("#", "")
                .toLowerCase();
    }

    /*
     * =====================================
     * FLEXIBLE FIELD EXTRACTION
     * =====================================
     */

    private static String getFieldValue(
            Map<String, String> fields,
            String... aliases) {

        for (String key :
                fields.keySet()) {

            String normalizedKey =
                    normalizeKey(key);

            for (String alias :
                    aliases) {

                String normalizedAlias =
                        normalizeKey(alias);

                if (normalizedKey.equals(
                        normalizedAlias)) {

                    return normalize(
                            fields.get(key));
                }
            }
        }

        return "";
    }
}
